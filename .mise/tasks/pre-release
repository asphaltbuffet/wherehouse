#!/usr/bin/env bash
#MISE description="generate release notes from CHANGELOG"
#MISE hide=true
#MISE sources=["CHANGELOG.md", "VERSION"]
#MISE outputs=["release_notes/notes.md"]

set -euo pipefail

if [ ! -f VERSION ]; then
  echo "Error: VERSION file not found"
  exit 1
fi

version=$(tr -d '[:space:]' < VERSION)

chglog="CHANGELOG.md"

if [ ! -f "$chglog" ]; then
  echo "File not found: $chglog"
  exit 1
fi

rm -rf release_notes
mkdir release_notes

awk -v version="$version" '
  BEGIN { found=0 }
  {
    if ($0 ~ "^## \\[" version "\\]") {
      found=1;
      next
    } else if ($0 ~ "^## " || $0 ~ "^\\[") {
      found=0
    }

    if (found) { print }
  }
  END { print "\nSee full changelog at [CHANGELOG.md](CHANGELOG.md)\n"}
' "$chglog" > "release_notes/notes.md"

if [ ! -s release_notes/notes.md ]; then
  echo "Error: release_notes/notes.md is empty — no CHANGELOG entry found for ${version}"
  exit 1
fi

echo "  ✓ release_notes/notes.md generated for ${version}"
