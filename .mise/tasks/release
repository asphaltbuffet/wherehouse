#!/usr/bin/env bash
#MISE description="Bump VERSION, update CHANGELOG pin check, and update README nix pins"
#USAGE arg "bump" help="Version bump type" {
#USAGE   choices "major" "minor" "patch"
#USAGE }

set -euo pipefail

bump="${usage_bump}"

# --- Read current version ---
if [ ! -f VERSION ]; then
  echo "Error: VERSION file not found"
  exit 1
fi

current=$(tr -d '[:space:]' < VERSION)

# --- Compute next version ---
next=$(semver bump "$bump" "$current")

echo "Current: ${current}"
echo "Next:    ${next}"
echo ""

# --- Assert new > current ---
if [ "$(semver compare "$next" "$current")" -le 0 ]; then
  echo "Error: new version ${next} is not greater than current ${current}"
  exit 1
fi

# --- Assert CHANGELOG entry exists ---
if ! grep -q "^## \[${next}\]" CHANGELOG.md; then
  echo "Error: no '## [${next}]' section found in CHANGELOG.md"
  echo "  Add a changelog entry before releasing"
  exit 1
fi
echo "  ✓ CHANGELOG.md has entry for ${next}"

# --- Write VERSION ---
echo "${next}" > VERSION
echo "  ✓ VERSION updated to ${next}"

# --- Update README nix pins ---
sd "github:asphaltbuffet/wherehouse/v${current}" "github:asphaltbuffet/wherehouse/v${next}" README.md
echo "  ✓ README.md nix pins updated"

echo ""
echo "Done. Commit VERSION, README.md, and CHANGELOG.md together and open a PR."
